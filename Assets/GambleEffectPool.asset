  - effectType: 3
    icon: {fileID: 21300000, guid: f8ebd11581f4b15489a343fb96c8ccf6, type: 3}
    description: A single, precise strike lands with devastating force on the enemy.
    amount: 40
    turns: 2
    multiplier: 1.5
  - effectType: 9
    icon: {fileID: 21300000, guid: c41eb8bccc0179442a98894b4a897600, type: 3}
    description: A warm wave restores half the strength of every hero.
    amount: 10
    turns: 2
    multiplier: 0.5
  - effectType: 10
    icon: {fileID: 21300000, guid: b79a9d91b85e55140a44b18adc69decc, type: 3}
    description: The whole party is wrapped in a protective barrier for several turns.
    amount: 20
    turns: 2
